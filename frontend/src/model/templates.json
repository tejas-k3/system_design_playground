[
 {
  "id": "three-tier",
  "title": "Classic three-tier",
  "summary": "Users, a load balancer, two app servers and one database: the baseline most designs grow from.",
  "diagram": {
   "nodes": [
    {
     "id": "users",
     "kind": "client",
     "x": 0,
     "y": 150,
     "label": "Users",
     "params": {
      "rps": 100,
      "readPct": 80
     }
    },
    {
     "id": "lb",
     "kind": "loadBalancer",
     "x": 240,
     "y": 150,
     "label": "Load Balancer",
     "params": {}
    },
    {
     "id": "app1",
     "kind": "appServer",
     "x": 480,
     "y": 60,
     "label": "App Server",
     "params": {}
    },
    {
     "id": "app2",
     "kind": "appServer",
     "x": 480,
     "y": 240,
     "label": "App Server 2",
     "params": {}
    },
    {
     "id": "db",
     "kind": "database",
     "x": 720,
     "y": 150,
     "label": "Database",
     "params": {}
    }
   ],
   "edges": [
    {
     "id": "users>lb",
     "from": "users",
     "to": "lb",
     "latencyMs": 40
    },
    {
     "id": "lb>app1",
     "from": "lb",
     "to": "app1",
     "latencyMs": 5
    },
    {
     "id": "lb>app2",
     "from": "lb",
     "to": "app2",
     "latencyMs": 5
    },
    {
     "id": "app1>db",
     "from": "app1",
     "to": "db",
     "latencyMs": 5
    },
    {
     "id": "app2>db",
     "from": "app2",
     "to": "db",
     "latencyMs": 5
    }
   ],
   "notes": []
  }
 },
